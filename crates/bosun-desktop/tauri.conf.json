{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bosun",
  "identifier": "dev.bosun.desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
